# Keep this value server-side. Never expose it with a NEXT_PUBLIC_ prefix.
NANSEN_API_KEY=replace_with_your_nansen_api_key

# Connect a PRIVATE Vercel Blob store to the project. Vercel supplies either
# BLOB_STORE_ID + VERCEL_OIDC_TOKEN at runtime, or a legacy read-write token.
BLOB_READ_WRITE_TOKEN=replace_with_private_blob_token

# Only this account can open /admin and read or export archived API responses.
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_bytes
